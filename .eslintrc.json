{
  "extends": [
    "next/core-web-vitals",
    "plugin:jest/recommended",
    "plugin:testing-library/react"
  ],
  "plugins": [
    "jest",
    "testing-library"
  ],
  "env": {
    "jest": true,
    "node": true
  },
  "rules": {
    "jest/expect-expect": "warn",
    "testing-library/await-async-queries": "error",
    "testing-library/no-debugging-utils": "warn"
  }
}